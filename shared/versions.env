# Versions shared by the iOS and native Android builds (sourced by their
# tools/*.sh). Anki's Python packages, its Rust core and the build hash they
# check against each other must come from the same release. The Termux
# variant uses ANKI_TAG too, for the anki release of krmanik/termux-packages
# (termux/tools/fetch_anki_debs.py).
ANKI_TAG=26.09.3
ANKI_PY_VERSION=26.9.3
QT_VERSION=6.11.0
PYQT6_VERSION=6.11.0
PYQT6_SIP_VERSION=13.13.0
SIP_VERSION=6.17.1
PYQT_BUILDER_VERSION=1.20.1
PYTHON_VERSION=3.14
# BeeWare's Python.xcframework for iOS (a release tag of
# beeware/Python-Apple-support)
PYTHON_APPLE_SUPPORT_TAG=3.14-b12
ORJSON_VERSION=3.12.0
RPDS_VERSION=2026.9.1
MARKUPSAFE_VERSION=3.0.4
# aqtinstall's default mirror sometimes stalls
QT_MIRROR=https://mirrors.ocf.berkeley.edu/qt/
# PyMuPDF for the native apps (shared/tools/build_pymupdf.sh); Incremento
# needs <2, and MUPDF_VERSION must be the one its setup.py names
PYMUPDF_VERSION=1.28.2
MUPDF_VERSION=1.28.2
# Programs add-ons start (ffmpeg, mecab, tesseract, ...), built into the
# native apps by shared/tools/build_programs.sh
FFMPEG_VERSION=9.0.2
LAME_VERSION=3.101
OGG_VERSION=1.3.6
VORBIS_VERSION=1.3.7
OPUS_VERSION=1.6.1
WEBP_VERSION=1.6.0
VPX_VERSION=1.17.0
AOM_VERSION=3.15.2
DAV1D_VERSION=1.5.4
# x264 has no releases: a commit of its stable branch
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55
KAKASI_VERSION=2.3.6
# MeCab's last release is 0.996 (2013): a commit of its repository
MECAB_COMMIT=61b90ba6e669dc2d7d533d4a80d206f3b31d52b1
# Tesseract with leptonica and its image libraries; tessdata_fast models for
# the languages Anki users OCR most (the rest: TESSDATA_PREFIX)
TESSERACT_VERSION=5.5.4
LEPTONICA_VERSION=1.87.0
PNG_VERSION=1.6.59
JPEG_VERSION=3.2.1
TESSDATA_COMMIT=87416418657359cb625c412a48b6e1d6d41c29bd
TESSDATA_LANGS="eng jpn jpn_vert chi_sim chi_tra kor"
ESPEAK_VERSION=1.52.0
