 }
@@ -564,11 +571,21 @@
 {
     [self sendShortcut:QKeySequence::Redo];
     [self rebuildUndoStack];
+}
+
+- (void)rememberUndoManager:(NSUndoManager *)undoMgr
+{
+    if (undoMgr == m_registeredUndoManager)
+        return;
+    [m_registeredUndoManager removeAllActionsWithTarget:self];
+    [m_registeredUndoManager release];
+    m_registeredUndoManager = [undoMgr retain];
 }
 
 - (void)registerRedo
 {
     NSUndoManager *undoMgr = self.undoManager;
+    [self rememberUndoManager:undoMgr];
